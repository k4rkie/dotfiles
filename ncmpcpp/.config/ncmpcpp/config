mpd_host = "localhost"
mpd_port = "6600"

##### directories #####
ncmpcpp_directory = ~/.config/ncmpcpp
lyrics_directory = ~/.lyrics

##### music visualizer #####
visualizer_data_source = /tmp/mpd.fifo
visualizer_output_name = Visualizer feed
visualizer_in_stereo = yes
visualizer_type = spectrum
visualizer_fps = 60
visualizer_autoscale = yes
visualizer_look = ┃│
visualizer_color = 47, 83, 119, 155, 191, 227, 221, 215
visualizer_spectrum_smooth_look = yes
visualizer_spectrum_dft_size = 2
visualizer_spectrum_gain = 10
visualizer_spectrum_hz_min = 20
visualizer_spectrum_hz_max = 20000

##### delays #####
playlist_disable_highlight_delay = 5
message_delay_time = 2

##### song format #####
song_list_format = $8%n. $1%t $R$8%l
song_status_format = $2%a $8- $1%t $8- $3%b
song_library_format = $8%n. $1%t
alternative_header_first_line_format = $1$b%t$/b$8
alternative_header_second_line_format = $2%a $8- $3%b $8($6%y$8)
current_item_prefix = $6$r
current_item_suffix = $/r$8
current_item_inactive_column_prefix = $5$r
current_item_inactive_column_suffix = $/r$8
now_playing_prefix = $1
now_playing_suffix = $8
browser_playlist_prefix = "$4playlist$8 "
selected_item_prefix = $3
selected_item_suffix = $8
modified_item_prefix = $2> $8
song_window_title_format = {%a - }{%t}|{%f}

##### columns settings #####
song_columns_list_format = (7f)[8]{NE} (25)[2]{a} (5f)[1]{l} (45)[8]{t|f:Title} (20)[3]{b}

##### various settings #####
playlist_show_mpd_host = no
playlist_show_remaining_time = no
playlist_shorten_total_times = no
playlist_separate_albums = no
playlist_display_mode = columns
