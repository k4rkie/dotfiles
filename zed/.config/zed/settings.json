{
  "debugger": {
    "button": false,
  },
  "terminal": {
    "font_family": "IosevkaTerm Nerd Font",
    "font_size": 20.0,
    "button": false,
  },
  "agent": {
    "button": false,
    "sidebar_side": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "vim_mode": true,
  "tab_size": 2,
  "current_line_highlight": "none",
  "extend_comment_on_newline": false,
  "hide_mouse": "on_typing_and_action",
  "cursor_blink": false,
  "show_completion_documentation": false,
  "inline_code_actions": true,
  "show_edit_predictions": false,
  "edit_predictions": {
    "provider": "copilot",
  },
  "indent_guides": {
    "enabled": false,
  },
  "buffer_line_height": {
    "custom": 1.35,
  },
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Gruvbox Material Dark Hard",
  },
  "theme_overrides": {
    "Gruvbox Material Dark Hard": {
      "border": "#000000",
      "border.variant": "#000000",
    },
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Light Charmed Icons",
    "dark": "Warm Charmed Icons",
  },
  "ui_font_family": "IosevkaTerm Nerd Font",
  "buffer_font_family": "IosevkaTerm Nerd Font",
  "ui_font_size": 20.0,
  "buffer_font_size": 20.0,
  "window_decorations": "server",
  "toolbar": {
    "code_actions": false,
    "agent_review": true,
    "selections_menu": true,
    "quick_actions": false,
    "breadcrumbs": false,
  },
  "tab_bar": {
    "show": false,
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false,
  },
  "tabs": {
    "git_status": false,
    "show_close_button": "hover",
  },
  "gutter": {
    "folds": false,
    "bookmarks": false,
    "breakpoints": true,
    "runnables": false,
    "min_line_number_digits": 0,
  },
  "scrollbar": {
    "show": "never",
  },
  "status_bar": {
    "show_active_file": true,
    "cursor_position_button": false,
    "active_encoding_button": "disabled",
    "active_language_button": false,
  },
  "title_bar": {
    "show_menus": false,
    "button_layout": "platform_default",
    "show_branch_status_icon": false,
    "show_user_picture": false,
    "show_user_menu": false,
    "show_sign_in": false,
    "show_onboarding_banner": true,
    "show_project_items": false,
    "show_branch_name": false,
  },
  "project_panel": {
    "default_width": 400,
    "button": false,
    "dock": "right",
    "auto_fold_dirs": false,
    "indent_guides": {
      "show": "never",
    },
  },
  "outline_panel": {
    "button": false,
  },
  "collaboration_panel": {
    "button": false,
  },
  "git_panel": {
    "button": false,
  },
  "search": {
    "button": false,
    "debugger": {
      "button": false,
    },
    "diagnostics": {
      "button": true,
    },
    "agent": {
      "flexible": false,
      "dock": "right",
      "sidebar_side": "right",
      "default_model": {
        "provider": "copilot_chat",
        "model": "gpt-4.1",
        "enable_thinking": false,
      },
      "favorite_models": [],
      "model_parameters": [],
    },
    "agent_servers": {
      "github-copilot-cli": {
        "type": "registry",
      },
    },
    "use_system_prompts": false,
    "use_system_path_prompts": false,
    "git": {
      "disable_git": false,
      "inline_blame": {
        "enabled": false,
      },
      "enable_diff": true,
      "enable_status": true,
    },
    "terminal": {
      "button": false,
      "toolbar": {
        "breadcrumbs": false,
      },
      "font_size": 22.0,
      "font_family": "IosevkaTerm Nerd Font",
    },
    "vim": {
      "cursor_shape": {
        "insert": "block",
      },
      "use_smartcase_find": true,
      "toggle_relative_line_numbers": true,
    },
    "file_finder": {
      "modal_max_width": "medium",
    },
    "file_scan_exclusions": [
      "**/node_modules/**",
      "**/.git/**",
      "**/dist/**",
      "**/.next/**",
    ],
    "session": {
      "trust_all_worktrees": true,
    },
    "restore_on_startup": "launchpad",
    "cli_default_open_behavior": "existing_window",
    "languages": {
      "TypeScript": {
        "show_edit_predictions": true,
      },
    },
  },
}
