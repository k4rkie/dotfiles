{
  "use_system_path_prompts": false,
  "cli_default_open_behavior": "existing_window",
  "restore_on_startup": "launchpad",
  "agent": {
    "flexible": false,
    "dock": "right",
    "sidebar_side": "right",
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4.1",
      "enable_thinking": false,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "show_edit_predictions": false,
  "edit_predictions": {
    "provider": "copilot",
  },
  "proxy": "",
  "git": {
    "disable_git": false,
    "inline_blame": {
      "enabled": false,
    },
    "enable_diff": true,
    "enable_status": true,
  },
  "tabs": {
    "git_status": false,
    "show_close_button": "hover",
  },
  "tab_bar": {
    "show": false,
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false,
  },
  "debugger": {
    "button": false,
  },
  "search": {
    "button": false,
  },
  "diagnostics": {
    "button": true,
  },
  "status_bar": {
    "show_active_file": true,
    "cursor_position_button": false,
    "active_encoding_button": "disabled",
    "active_language_button": false,
  },
  "project_panel": {
    "default_width": 500,
    "button": false,
    "dock": "right",
    "auto_fold_dirs": false,
    "indent_guides": {
      "show": "never",
    },
  },
  "vim": {
    "cursor_shape": {
      "insert": "block",
    },
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true,
  },
  "toolbar": {
    "code_actions": false,
    "agent_review": true,
    "selections_menu": true,
    "quick_actions": false,
    "breadcrumbs": false,
  },
  "scrollbar": {
    "show": "never",
  },
  "inline_code_actions": true,
  "indent_guides": {
    "enabled": false,
  },
  "gutter": {
    "folds": false,
    "bookmarks": false,
    "breakpoints": true,
    "runnables": false,
    "min_line_number_digits": 0,
  },
  "use_system_prompts": false,
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry",
    },
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "title_bar": {
    "show_menus": false,
    "button_layout": "platform_default",
    "show_branch_status_icon": false,
    "show_user_picture": false,
    "show_user_menu": false,
    "show_sign_in": false,
    "show_onboarding_banner": true,
    "show_project_items": false,
    "show_branch_name": false,
  },
  "window_decorations": "server",
  "ui_font_family": "IosevkaTerm Nerd Font",
  "buffer_font_family": "IosevkaTerm Nerd Font",
  "terminal": {
    "button": false,
    "toolbar": {
      "breadcrumbs": false,
    },
    "font_size": 20.0,
    "font_family": "IosevkaTerm Nerd Font",
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Light Charmed Icons",
    "dark": "Light Charmed Icons",
  },
  "vim_mode": true,
  "ui_font_size": 20.0,
  "buffer_font_size": 20.0,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Base16 Black Metal",
  },
  "theme_overrides": {
    "Base16 Black Metal": {
      "border": "#080808",
      // "editor.document_highlight.read_background": "#00000000",
      // "editor.document_highlight.write_background": "#00000000",
    },
  },
  "current_line_highlight": "none",
  "extend_comment_on_newline": false,
  "file_finder": {
    "modal_max_width": "medium",
  },
  "hide_mouse": "on_typing_and_action",
  "cursor_blink": false,
  "show_completion_documentation": false,
  "outline_panel": { "button": false },
  "collaboration_panel": { "button": false },
  "git_panel": { "button": false },
}
