{
  "disable_ai": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "restore_on_startup": "launchpad",
  "session": {
    "trust_all_worktrees": true
  },
  "which_key": {
    "enabled": true
  },
  "snippet_sort_order": "inline",
  "drop_target_size": 0.2,
  "relative_line_numbers": "enabled",
  "vim": {
    "toggle_relative_line_numbers": true,
    "cursor_shape": {
      "insert": "block"
    },
    "use_smartcase_find": true
  },
  "use_system_path_prompts": false,
  "use_system_prompts": false,
  "debugger": {
    "button": false
  },
  "terminal": {
    "font_family": "Maple Mono NF",
    "font_size": 22.0,
    "button": false,
    "toolbar": {
      "breadcrumbs": false
    }
  },
  "agent": {
    "button": false,
    "sidebar_side": "right",
    "favorite_models": [],
    "model_parameters": [],
    "flexible": false,
    "dock": "right",
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4.1",
      "enable_thinking": false
    }
  },
  "vim_mode": true,
  "tab_size": 2,
  "current_line_highlight": "none",
  "extend_comment_on_newline": false,
  "hide_mouse": "on_typing_and_action",
  "cursor_blink": false,
  "show_completion_documentation": false,
  "inline_code_actions": true,
  "show_edit_predictions": false,
  "edit_predictions": {
    "provider": "copilot"
  },
  "indent_guides": {
    "enabled": false
  },
  "buffer_line_height": {
    "custom": 1.35
  },
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Tokyo Night Dark"
  },
  "theme_overrides": {
    "Base16 Black Metal (Bathory Tweaked)": {
      "border": "#00000000",
      "border.variant": "#00000000"
    }
  },
  "icon_theme": {
    "mode": "light",
    "light": "Light Charmed Icons",
    "dark": "Warm Charmed Icons"
  },
  "ui_font_family": "Maple Mono NF",
  "buffer_font_family": "Maple Mono NF",
  "ui_font_size": 22.0,
  "buffer_font_size": 24.0,
  "window_decorations": "server",
  "toolbar": {
    "code_actions": false,
    "agent_review": true,
    "selections_menu": true,
    "quick_actions": false,
    "breadcrumbs": false
  },
  "tab_bar": {
    "show": false,
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false
  },
  "tabs": {
    "git_status": false,
    "show_close_button": "hover"
  },
  "gutter": {
    "folds": false,
    "bookmarks": false,
    "breakpoints": true,
    "runnables": false,
    "min_line_number_digits": 0
  },
  "scrollbar": {
    "axes": {
      "horizontal": false
    },
    "show": "never"
  },
  "status_bar": {
    "show_active_file": true,
    "cursor_position_button": false,
    "active_encoding_button": "disabled",
    "active_language_button": false
  },
  "title_bar": {
    "show_menus": false,
    "button_layout": "platform_default",
    "show_branch_status_icon": false,
    "show_user_picture": false,
    "show_user_menu": false,
    "show_sign_in": false,
    "show_onboarding_banner": true,
    "show_project_items": false,
    "show_branch_name": false
  },
  "project_panel": {
    "default_width": 400,
    "button": false,
    "dock": "right",
    "auto_fold_dirs": false,
    "indent_guides": {
      "show": "never"
    }
  },
  "outline_panel": {
    "button": false
  },
  "collaboration_panel": {
    "button": false
  },
  "git_panel": {
    "button": false
  },
  "search": {
    "button": false,
    "debugger": {
      "button": false
    },
    "diagnostics": {
      "button": true
    }
  },
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "git": {
    "disable_git": false,
    "inline_blame": {
      "enabled": false
    },
    "enable_diff": true,
    "enable_status": true
  },
  "file_finder": {
    "modal_max_width": "medium"
  },
  "file_scan_exclusions": [
    "**/node_modules/**",
    "**/.git/**",
    "**/dist/**",
    "**/.next/**"
  ],
  "cli_default_open_behavior": "existing_window",
  "languages": {
    "TypeScript": {
      "show_edit_predictions": true
    }
  }
}
