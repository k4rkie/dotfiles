@import "~/.config/rofi/colors-rofi-dark.rasi"
configuration {
	  modi:                       "drun,filebrowser";
    show-icons:                 true;
    icon-theme:                 "matefaenzadark";
    display-drun:               "  Apps";
    display-filebrowser:        "  Files";
    drun-display-format:        "{name}";
}
*{
    font : "MonasevkaCode Nerd Font 14";
}
window {
    /* properties for window widget */
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       25%;
    x-offset:                    0px;
    y-offset:                    0px;

    /* properties for all widgets */
    enabled:                     true;
    margin:                      0px;
    padding:                     6px;
    border:                      3px solid;
    border-color:                #0e1113;
    border-radius:               0px;
    cursor:                      "default";
}
/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       6;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                false;
    fixed-columns:               true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     6px;
    border:                      0px solid;
    border-radius:               0px;
    cursor:                      "default";
}

entry {
    placeholder: "Search...";
    placeholder-color: #444444;
}
