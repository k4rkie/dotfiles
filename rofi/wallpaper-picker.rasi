@import "colors-rofi-dark.rasi"
* {
    font: "SFMono Nerd Font 12";
    background-color: transparent;
    text-color: @foreground;
}
window {
    width: 50%;
    height: 360px;
    location: center;
    anchor: center;
    border: 0;
    border-radius: 0;
    padding: 14px;
    background-color: @background;
}
mainbox {
    spacing: 8px;
    children: [ inputbar, listview ];
}
inputbar {
    padding: 12px 18px;
    spacing: 12px;
    border-radius: 0;
    background-color: @background;
    children: [ prompt, entry ];
}
entry {
    placeholder: "Search wallpaper...";
    text-color: @foreground;
    background-color: transparent;
    placeholder-color: #444444;
}
listview {
    columns: 3;
    lines: 1;
    flow: horizontal;
    fixed-height: true;
    fixed-columns: true;
    cycle: false;
    scrollbar: false;
    padding: 0px;
    spacing: 0px;
    border: 0px;
}
element {
    orientation: vertical;
    padding: 0px;
    margin: 0px;
    spacing: 2px;
    border-radius: 0;
}
element selected.normal {
    background-color: @selected-normal-background-wallpaper;
    text-color: @selected-normal-foreground;
    border-radius: 0;
}
element-icon {
    size: 250px;
    border-radius: 0;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}
element-text {
    horizontal-align: 0.5;
    text-color: transparent;
}
