@import "colors-rofi-dark"

* {
    font:               "GeistMono Nerd Font 11";
    margin:             0px;
    padding:            0px;
    spacing:            0px;
    background-color:   transparent;
}

window {
    location:           center;
    width:              780px;
    border-radius:      4px;
    background-color:   @background;
    padding:            12px;
}

mainbox {
    padding:            0px;
}

inputbar {
    background-color:   @background;
    spacing:            8px;
    border-radius:      4px;
    padding:            8px 12px;
    border:             1px;
    border-color:       #1c1c1c;
    children:           [entry];
}

entry {
    placeholder:        "Search wallpapers...";
    placeholder-color:  #666666;
    text-color:         @foreground;
}

listview {
    margin:             12px 0 0 0;
    lines:              2;
    columns:            4;
    fixed-height:       true;
    fixed-columns:      true;
    spacing:            8px;
}

element {
    border-radius:      4px;
    padding:            6px;
    cursor:             pointer;
    color:              @foreground;
    orientation:        vertical;
    children:           [element-icon, element-text];
}

element-text {
    margin:             4px 0 0 0;
    text-color:         inherit;
    vertical-align:     0.5;
    horizontal-align:   0.5;
}

element-icon {
    size:               6em;
    cursor:             pointer;
    border-radius:      4px;
}

element selected normal,
element selected active {
    border:             2px;
    border-color:       #83a598;
    background-color:   transparent;
    text-color:         @foreground;
}
