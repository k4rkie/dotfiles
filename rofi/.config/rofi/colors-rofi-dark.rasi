* {
    /* Base colors */
    background: #080808;          
    background-color: #080808;
    foreground: #ddc7a1;         
    border-color: #080808;
    spacing: 2;

    /* States */
    active-background: #7fa563;   /* subtle green accent */
    active-foreground: #080808;

    normal-background: #080808;
    normal-foreground: #ddc7a1;

    urgent-background: #d8647e;  /* red for urgent */
    urgent-foreground: #080808;

    /* Selected (highlighted) entries */
    selected-active-background: #7fa563;  /* same as active */
    selected-active-foreground: #080808;

    selected-normal-background: #83a598; /* slightly lighter for normal selection */
    selected-normal-foreground: #080808;
    selected-urgent-background: #d8647e;
    selected-urgent-foreground: #080808;

    /* Optional alternates for subtle row differences */
    alternate-normal-background: #080808;
    alternate-normal-foreground: #ddc7a1;
    alternate-active-background: #7fa563;
    alternate-active-foreground: #080808;
    alternate-urgent-background: #d8647e;
    alternate-urgent-foreground: #080808;

}

#window {
    background-color: @background;
    border: 0;
    padding: 2.5ch;
}

#mainbox {
    border: 0;
    padding: 0;
}

#message {
    border: 6px 0px 0px;
    border-color: @border-color;
    padding: 1px;
}

#textbox {
    text-color: @foreground;
}

#inputbar {
    children:   [ prompt,textbox-prompt-colon,entry,case-indicator ];
}

#textbox-prompt-colon {
    expand: false;
    str: ":";
    margin: 0px 0.3em 0em 0em;
    text-color: @normal-foreground;
}

#listview {
    fixed-height: 0;
    border: 6px 0px 0px;
    border-color: @border-color;
    spacing: 2px;
    scrollbar: true;
    padding: 2px 0px 0px;
}

#element {
    border-radius: 4px;
    padding: 2px;
}

#element-text, element-icon {
    background-color: inherit;
    text-color:       inherit;
}

#element.normal.normal {
    background-color: @normal-background;
    text-color: @normal-foreground;
}

#element.normal.urgent {
    background-color: @urgent-background;
    text-color: @urgent-foreground;
}

#element.normal.active {
    background-color: @active-background;
    text-color: @active-foreground;
}

#element.selected.normal {
    background-color: @selected-normal-background;
    text-color: @selected-normal-foreground;
}

#element.selected.urgent {
    background-color: @selected-urgent-background;
    text-color: @selected-urgent-foreground;
}

#element.selected.active {
    background-color: @selected-active-background;
    text-color: @selected-active-foreground;
}

#element.alternate.normal {
    background-color: @alternate-normal-background;
    text-color: @alternate-normal-foreground;
}

#element.alternate.urgent {
    background-color: @alternate-urgent-background;
    text-color: @alternate-urgent-foreground;
}

#element.alternate.active {
    background-color: @alternate-active-background;
    text-color: @alternate-active-foreground;
}

#scrollbar {
    width: 4px;
    border: 0;
    handle-width: 8px;
    padding: 0;
}

#sidebar {
    border: 2px 0px 0px;
    border-color: @border-color;
}

#button {
    text-color: @normal-foreground;
}

#button.selected {
    background-color: @selected-normal-background;
    text-color: @selected-normal-foreground;
}

#inputbar {
    spacing: 0;
    text-color: @normal-foreground;
    padding: 1px;
}

#case-indicator {
    spacing: 0;
    text-color: @normal-foreground;
}

#entry {
    spacing: 0;
    text-color: @normal-foreground;
}

#prompt {
    spacing: 0;
    text-color: @normal-foreground;
}
