# Text/base colors
gtk-color-scheme = "text_color:#727272\nbase_color:#000000"
# Foreground/background colors
gtk-color-scheme = "fg_color:#c0c0c0\nbg_color:#0a0a0a"
# Selection colors
gtk-color-scheme = "selected_fg_color:#000\nselected_bg_color:#4e5687"
# Tooltip colors
gtk-color-scheme = "tooltip_fg_color:#f8f8f2\ntooltip_bg_color:#1a1a1a"
# Window colors
gtk-color-scheme = "wm_color:#0a0a0a\nunfocused_wm_color:#0a0a0a"
# Panel colors
gtk-color-scheme = "panel_bg_color:#000000\npanel_fg_color:#c0c0c0"
# Dark Theme - Text/base colors
gtk-color-scheme = "dark_text_color:#c0c0c0\ndark_base_color:#000000"
# Dark Theme - Foreground/background colors
gtk-color-scheme = "dark_fg_color:#c0c0c0\ndark_bg_color:#0a0a0a"
gtk-color-scheme = "sidebar_bg:#0a0a0a"
gtk-color-scheme = "sidebar_fg:#c0c0c0"

gtk-auto-mnemonics = 1
gtk-primary-button-warps-slider = 1

include "main.rc"

# App stylings
include "apps/chrome.rc"
include "apps/gimp.rc"
include "apps/libreoffice.rc"
include "apps/terminal.rc"
include "apps/thunar.rc"
