# Sway config - ported from Hyprland Lua config

set $mod Mod4

font pango:FiraCode Nerd Font 11

# Input
input * {
    xkb_options caps:escape
}

input "type:touchpad" {
    natural_scroll enabled
    drag_lock enabled
}

# Autostart
exec --no-startup-id nm-applet
exec_always --no-startup-id blueman-applet
exec --no-startup-id swaync
exec --no-startup-id swayosd-server
exec_always --no-startup-id swaybg -i "$(cat ~/.config/hypr/current_wallpaper 2>/dev/null || echo '/home/k4rkie/Pictures/Wallhaven/sea_sky_clouds_sand_beach_beacon_sunset_purple.jpg')" -m fill
exec_always --no-startup-id wlsunset -l 27.7006 -L 83.4484 -t 3800 -T 6500
exec_always --no-startup-id gsettings set org.gnome.desktop.interface font-name 'FiraCode Nerd Font 11'
exec_always --no-startup-id gsettings set org.gnome.desktop.interface gtk-theme 'Void'
exec_always --no-startup-id gsettings set org.gnome.desktop.interface icon-theme 'Papirus-Dark'
exec_always --no-startup-id gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
exec_always --no-startup-id sed -i 's/gtk-icon-theme-name="hicolor"/gtk-icon-theme-name="Papirus-Dark"/' "${HOME}/.gtkrc-2.0"
exec --no-startup-id ~/scripts/mpd-notify.sh
exec --no-startup-id wl-paste --type text --watch cliphist store
exec --no-startup-id wl-paste --type image --watch cliphist store

bar {
    swaybar_command waybar
}

# Media keys
bindsym XF86AudioRaiseVolume exec swayosd-client --output-volume +2
bindsym XF86AudioLowerVolume exec swayosd-client --output-volume -2
bindsym XF86AudioMute exec swayosd-client --output-volume mute-toggle
bindsym XF86MonBrightnessUp exec swayosd-client --brightness +2
bindsym XF86MonBrightnessDown exec swayosd-client --brightness -2
bindsym XF86AudioPlay exec mpc toggle
bindsym XF86AudioNext exec mpc next
bindsym XF86AudioPrev exec mpc prev
bindsym XF86AudioStop exec mpc stop

floating_modifier $mod

# Utils menu
bindsym $mod+Shift+u exec rofi -show Utils -modi 'Utils:~/scripts/utils-menu.sh'

# Launcher / Session
bindsym $mod+Return exec kitty
bindsym $mod+b exec /opt/zen/zen-bin
bindsym $mod+Shift+f exec thunar
bindsym $mod+Shift+q kill
bindsym $mod+d exec rofi -show
bindsym $mod+Escape exec ~/scripts/rofi-powermenu
bindsym $mod+p exec hyprpicker -a -n
bindsym $mod+Shift+s exec ~/scripts/rofi-sessionizer.sh
bindsym $mod+Shift+c reload
bindsym $mod+Shift+w exec killall -SIGUSR1 waybar
bindsym $mod+v exec ~/scripts/rofi-cliphist.sh
bindsym $mod+period exec ~/scripts/rofi-emoji.sh
bindsym $mod+w exec ~/scripts/rofi-wallpaper.sh
bindsym $mod+Shift+e exec rofimoji --keybinding-copy Alt+Return --max-recent 3 --prompt "Emoji"

# Focus movement (h left, j down, k up, l right)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Layout / Windows
bindsym $mod+f fullscreen toggle
bindsym $mod+e layout toggle split
bindsym $mod+Shift+t floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Resize mode
mode "resize" {
    bindsym h resize shrink width 5 px or 5 ppt
    bindsym j resize grow height 5 px or 5 ppt
    bindsym k resize shrink height 5 px or 5 ppt
    bindsym l resize grow width 5 px or 5 ppt
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# Window rules
for_window [app_id="pavucontrol"] floating enable, move position center
for_window [app_id="blueman-manager"] floating enable, move position center
for_window [app_id="qalculate-gtk"] floating enable, move position center
for_window [app_id="imv"] floating enable, move position center
for_window [app_id="rmpc"] floating enable, move position center
for_window [app_id="btop"] floating enable, move position center


# Gaps
gaps inner 4
gaps outer 8

# Borders
default_border pixel 0
default_floating_border pixel 0

# Colors
client.focused #58796c #58796c #111111 #58796c #58796c
client.focused_inactive #202020 #202020 #888888 #202020 #202020
client.unfocused #202020 #202020 #888888 #202020 #202020

# Display scale
output eDP-1 scale 1
