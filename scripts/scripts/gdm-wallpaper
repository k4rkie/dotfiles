#!/bin/sh
# GDM wallpaper changer for GNOME Shell 50
# Safe, rerunnable after gnome-shell updates
# Usage: ./gdm-wallpaper [/path/to/wallpaper]

set -euo pipefail

cleanup() { rm -rf "${WORKDIR:-}"; }
trap cleanup EXIT

WALLPAPER="${1:-$HOME/Pictures/Wallhaven/wallpaper.jpg}"
WORKDIR="/tmp/gdm-wallpaper-$$"
THEMEDIR="$WORKDIR/theme"
GRESOURCE="/usr/share/gnome-shell/gnome-shell-theme.gresource"
BACKUP="/usr/share/gnome-shell/gnome-shell-theme.gresource.bak"

# Check wallpaper exists
if [ ! -f "$WALLPAPER" ]; then
    echo "Error: wallpaper not found at '$WALLPAPER'" >&2
    exit 1
fi

WALLPAPER_FILENAME=$(basename "$WALLPAPER")

# Check gresource exists
if [ ! -f "$GRESOURCE" ]; then
    echo "Error: $GRESOURCE not found" >&2
    exit 1
fi

echo "Extracting current GDM theme..."
mkdir -p "$THEMEDIR"
for r in $(gresource list "$GRESOURCE"); do
    target="${r#\/org\/gnome\/shell\/}"
    dir=$(dirname "$target")
    mkdir -p "$WORKDIR/$dir"
    gresource extract "$GRESOURCE" "$r" > "$WORKDIR/$target"
done

echo "Copying wallpaper..."
cp "$WALLPAPER" "$THEMEDIR/$WALLPAPER_FILENAME"

echo "Creating gresource XML..."
cat > "$THEMEDIR/gnome-shell-theme.gresource.xml" << EOF
<?xml version="1.0" encoding="UTF-8"?>
<gresources>
  <gresource prefix="/org/gnome/shell/theme">
    <file>calendar-today-light.svg</file>
    <file>calendar-today.svg</file>
    <file>gnome-shell-dark.css</file>
    <file>gnome-shell-high-contrast.css</file>
    <file>gnome-shell-light.css</file>
    <file>gnome-shell-start.svg</file>
    <file>pad-osd.css</file>
    <file>workspace-placeholder.svg</file>
    <file>$WALLPAPER_FILENAME</file>
  </gresource>
</gresources>
EOF

echo "Patching CSS files..."
for css in gnome-shell-light.css gnome-shell-dark.css gnome-shell-high-contrast.css; do
    perl -i -pe "BEGIN{undef \$/;} s|#lockDialogGroup \{[^}]*\}|#lockDialogGroup {\n  background: url(\"$WALLPAPER_FILENAME\");\n  background-size: cover;\n  background-repeat: no-repeat;\n}|g" "$THEMEDIR/$css"
done

echo "Compiling theme..."
(cd "$THEMEDIR" && glib-compile-resources gnome-shell-theme.gresource.xml)

echo "Installing (backup saved as $BACKUP)..."
sudo cp "$GRESOURCE" "$BACKUP"
sudo cp "$THEMEDIR/gnome-shell-theme.gresource" "$GRESOURCE"

echo "Done! Restart GDM or logout to see changes."
echo "After gnome-shell updates, just re-run this script."
