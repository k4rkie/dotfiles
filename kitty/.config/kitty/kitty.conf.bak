
font_family      FiraCode Nerd Font
font_size 15.0
texr_composition_strategy legacy

window_padding_width 0
# cursor #918478
cursor_trail 10
cursor_trail_start_threshold 0
cursor_trail_decay 0.01 0.20
cursor_shape block
cursor_blink true
    
background_opacity 0.99

# BEGIN_KITTY_THEME
# Black Metal
include current-theme.conf
# END_KITTY_THEME
