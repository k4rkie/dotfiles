{
  "layer": "top",
  "position": "bottom",
  "reload_style_on_change": true,
  // "margin-right": 130,
  // "margin-left": 130,
  "height": 18,
  "modules-left": [
    "custom/tag",
    "ext/workspaces",
  ],
  "modules-center": [
    "clock",
  ],
  "modules-right": [
    "memory",
    "cpu",
    "pulseaudio",
    "battery",
    "custom/separator",
    "custom/caffeine",
    "custom/notifications",
    "tray"
  ],
  "tray": {
    "icon-size": 14,
    "spacing": 4
  },
  "clock": {
    "format": "{:%I:%M %p}",
    "interval": 60,
    "tooltip": true,
    "tooltip-format": "<big>{calendar}</big>",
    "on-click": "",
    "calendar": {
        "mode": "month",
        "format": {
          "months": "<span color='#ab4642'><b>{}</b></span>",
          "days": "<span color='#c1c1c1'><b>{}</b></span>",
          "weekdays": "<span color='#94f978'><b>{}</b></span>",
          "today": "<span color='#ff9e64'><b><u>{}</u></b></span>"
      }
    }
  },
  "ext/workspaces": {
    "format": "{icon}",
    "ignore-hidden": true,
    "on-click": "activate",
    "sort-by-id": true,
    "format-icons": {
      "1": "I",
      "2": "II",
      "3": "III",
      "4": "IV",
      "5": "V",
      "6": "VI",
      "7": "VII",
      "8": "VIII",
      "9": "IX",
      "10": "X"
    }
  },
  "memory": {
    "format": "mem:{}%",
    "tooltip": "false",
    "on-click": "kitty --class btop btop",
  },
  "cpu": {
    "format": "cpu:{usage}%",
    "tooltip": "false",
    "on-click": "kitty --class btop btop",
  },
  "pulseaudio": {
    "format": "vol:{volume}%",
    "format-muted": "volx:{volume}%",
    "scroll-step": 1,
    "on-click": "pavucontrol"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "bat:{capacity}%",
    "format-charging": "pow{capacity}%",
    "format-plugged": "pow:{capacity}%",
    "format-full": "pow:{capacity}%",
  },
  "custom/recording": {
    "exec": "/home/k4rkie/scripts/wf-status.sh",
    "interval": 1
  },
  "network": {
    "format": "󰖩 ",
    "format-wifi": "󰖩 ",
    "format-ethernet": "󰈀 ",
    "format-disconnected": "󰖪 ",
    "tooltip-format": "{ifname}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
    "tooltip-format-ethernet": "{ifname}󰈀 ",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "~/scripts/rofi-wifi-menu.sh"
  },
  "custom/tag": {
    "format": "tag :",
    "interval": "once",
    "tooltip": false,
  },
  "custom/notifications": {
    "tooltip": true,
    "format": "<span size='12pt'>{icon}</span>",
    "format-icons": {
      "notification": "󱅫",
      "none": "",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "custom/caffeine": {
    "exec": "~/scripts/caffeine-status.sh",
    "on-click": "~/scripts/caffeine-toggle.sh",
    "return-type": "json",
    "interval": 10,
    "signal": 8,
    "tooltip": true
  },
  "custom/keyboard": {
    "exec": "~/scripts/kbtoggle.sh",
    "on-click": "~/scripts/kbtoggle.sh --toggle && pkill -RTMIN+8 waybar",
    "return-type": "json",
    "interval": 5,
    "signal": 8,
    "tooltip": false
  },
  "custom/separator": {
    "format": "|",
    "tooltip": false,
  },
  "group/media": {
    "orientation": "horizontal",
    "modules": [
      "custom/media-animation",
      "custom/media-now-playing",
      "custom/media-time"
    ]
  },
  "custom/media-now-playing": {
    "exec": "/home/k4rkie/.config/waybar/custom_modules/media/media-now-playing.sh",
    "escape": true,
    "tooltip": false,
    "on-click": "kitty --class rmpc rmpc",
    "on-click-middle": "mpc prev",
    "on-click-right": "mpc next",
  },
  "custom/media-animation": {
    "exec": "~/.config/waybar/custom_modules/media/media-animation.sh",
    "tooltip": false,
    "on-click": "mpc toggle",
  },
  "custom/media-time": {
    "exec": "~/.config/waybar/custom_modules/media/media-time.sh",
    "escape": true,
    "interval": 1,
    "tooltip": false,
  }
}
