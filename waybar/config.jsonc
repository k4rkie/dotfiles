{
  "layer": "top",
  "position": "bottom",
  "height": 32,
  "margin-left": 200,
  "margin-right": 200,
  "reload_style_on_change": true,
  "modules-left": [
    "idle_inhibitor",
    "custom/sep",
    "battery",
    "custom/sep",
    "clock",
  ],
  "modules-center": [
    "mango/workspaces",
  ],
  "modules-right": [
    "memory",
    "custom/sep",
    "disk#a",
    "custom/sep",
    "network",
    "tray"
  ],
  "mango/workspaces": {
    "format": "{icon}",
    "hide-empty": true,
    "on-click": "activate",
    "overview-label": "OVERVIEW",
  },
  "mango/window": {
    "format": "{app_id}",
    "icon": true,
    "icon-size": 20
  },
  "mango/layout": {
      "format": "[{symbol}]",
  },
  "clock": {
    "format": " {:%I:%M %p}",
    "interval": 60,
    "format-alt": " {:%A, %B %d}",
    "tooltip-format": "<span size='12pt' font='SFMono Nerd Font'>{calendar}</span>",
    "calendar": {
      "mode"          : "month",
      "mode-mon-col"  : 3,
      "weeks-pos"     : "right",
      "on-scroll"     : 1,
      "on-click-right": "mode",
      "format": {
        "months":     "<span color='#95b1b7'><b>{}</b></span>",
        "days":       "<span color='#908caa'><b>{}</b></span>",
        "weeks":      "<span color='#9faa7b'><b>W{}</b></span>",
        "weekdays":   "<span color='#d89868'><b>{}</b></span>",
        "today":      "<span color='#c27282'><b><u>{}</u></b></span>"
      }
    }
  },
  "memory": {
    "format": " :{percentage}%",
    "interval": 10,
    "on-click": "foot -a btop btop",
    "tooltip-format": "{used:0.1f}G/{total:0.1f}G used"
  },
  "custom/sep": {
    "format": "󰇙",
    "interval": "once"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶 :ON",
      "deactivated": "󰾪 :OFF"
    },
    "tooltip": true,
    "tooltip-format": "Caffienate [{status}]"
  },
  "disk#a": {
    "format": " :{percentage_used}%",
    "interval": 3600
  },
  "battery": {
    "format": "{icon}:{capacity}%",
    "format-charging": "{icon}󱐋:{capacity}%",
    "format-full": "{icon}:{capacity}%",
    "tooltip-format": "{timeTo} · {capacity}%",
    "tooltip-format-charging": "Charging · {capacity}%",
    "tooltip-format-discharging": "Discharging · {capacity}%",
    "tooltip-format-full": "Full · plugged in",
    "tooltip-format-plugged": "Plugged in · {capacity}%",
    "tooltip-format-not-charging": "Not charging · {capacity}%",
    "tooltip-format-unknown": "Unknown · {capacity}%",
    "format-icons": {
      "default": [
        " ",
        " ",
        " ",
        " ",
        " ",
        " ",
        " ",
        " ",
        " ",
        " ",
        " "
      ]
    },
    "states": {
      "warning": 30,
      "critical": 15
    },
    "interval": 60
  },
  "network": {
    "format-wifi": "󱚻 :{signalStrength}%",
    "format-disconnected": "󰖪 :OFF",
    "on-click": "foot -a nmtui nmtui",
    "interval": 10
  },
  "tray": {
    "icon-size": 22,
    "spacing": 8
  }
}
