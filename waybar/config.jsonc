{
  "layer": "top",
  "position": "bottom",
  "reload_style_on_change": true,
  "height": 18,
  "modules-left": [
    "mango/workspaces",
    "mango/window"
  ],
  "modules-center": [],
  "modules-right": [
    "memory",
    "clock",
    "battery",
    "custom/control-center",
    "tray"
  ],
  "mango/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "one",
      "2": "two",
      "3": "three",
      "4": "four",
      "5": "five",
      "6": "six",
      "7": "seven",
      "8": "eight",
      "9": "nine",
    },
    "on-click": "activate",
    "hide-empty": true
  },
  "mango/window": {
    "format": "{app_id}",
    "icon": true,
    "icon-size": 18,
    "rewrite": {
      ".*firefox*": "firefox"
    }
  },
  "mango/layout": {
      "format": "[] {symbol}",
      "format-S": "󰌌 {symbol}",
      "format-M": "󰕰 {symbol}"
  },
  "clock": {
    "format": "{:%I:%M %p}",
    "interval": 60,
    "tooltip": false,
    "on-click": "quickshell ipc call calendar toggle",
  },
  "memory": {
    "format": "mem:{}%",
    "tooltip": "false",
    "on-click": "foot -a btop btop",
  },
  "cpu": {
    "format": "cpu:{usage}%",
    "tooltip": "false",
    "on-click": "foot -a btop btop",
  },
  "battery": {
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "bat:{capacity}%",
    "format-charging": "bat:󱐋{capacity}%",
    "format-icons": ["󰂎", "󱊡", "󱊢", "󱊣"],
    "tooltip": true,
    "max-length": 25
  },
  "tray": {
    "icon-size": 14,
    "spacing": 4
  },
  "custom/control-center": {
    "format": "ctrl:󰢻",
    "on-click": "quickshell ipc call control toggle",
    "tooltip": false
  },
  "custom/separator": {
    "format": "|"
  }
}
