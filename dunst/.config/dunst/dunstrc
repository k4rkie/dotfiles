[global]
    font = IosevkaTerm Nerd Font 12

    width = 320
    height = 80
    offset = 20x20
    origin = top-right

    padding = 14
    horizontal_padding = 16
    text_icon_padding = 12

    frame_width = 2
    frame_color = "#222222"

    separator_height = 0

    corner_radius = 12

    transparency = 0

    alignment = left
    word_wrap = yes
    markup = full

    shrink = yes
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0

    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    idle_threshold = 120
    show_age_threshold = 60

    stack_duplicates = false
    hide_duplicate_count = false

    format = "<b>%s</b>\n%b"

[urgency_low]
    background = "#0d0d0ddd"
    foreground = "#909090"
    highlight = "#909090"
    timeout = 4

[urgency_normal]
    background = "#0d0d0ddd"
    foreground = "#909090"
    highlight = "#909090"
    timeout = 6

[urgency_critical]
    background = "#1a0f10dd"
    foreground = "#909090"
    frame_color = "#ff5c57"
    highlight = "#ff5c57"
    timeout = 0
