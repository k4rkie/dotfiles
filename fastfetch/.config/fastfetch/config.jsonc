{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "vanilla_small",
    "padding": {
      "top": 1,
      "left": 2,
      "bottom": 3
    },
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    "break",
    "title",
    {
      "type": "os",
      "key": "os    ",
      "keyColor": "33",
    },
    {
      "type": "kernel",
      "key": "kernel",
      "keyColor": "33",
    },
    {
      "type": "host",
      "format": "{5} {1}",
      "key": "host  ",
      "keyColor": "33",
    },
    {
      "type": "packages",
      "format": "{} (dnf)",
      "key": "pkgs  ",
      "keyColor": "33",
    },
    {
      "type": "uptime",
      "format": "{2}h {3}m",
      "key": "uptime",
      "keyColor": "33",
    },
    {
      "type": "command",
      "key": "age   ",
      "keyColor": "33",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "memory",
      "key": "memory",
      "keyColor": "33",
    },
    "break",
  ]
}
