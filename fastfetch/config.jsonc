{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "auto",
        "padding": {
            "left": 1
        }
    },
    "display": {
        "separator": ": ",
        "color": {
            "keys": "magenta"
        },
        "size": {
            "ndigits": 0,
            "maxPrefix": "MB",
            "spaceBeforeUnit": "never"
        },
        "freq": {
            "ndigits": 3,
            "spaceBeforeUnit": "never"
        },
        "key": {
            "type": "string"
        }
    },
    "modules": [
        {
            "type": "title",
            "color": {
                "user": "green",
                "at": "red",
                "host": "blue"
            }
        },
        "separator",
        "os",
        {
            "type": "board",
            "key": "Host",
            "format": "{vendor} {name}"
        },
        {
            "type": "kernel",
            "format": "{release}"
        },
        "uptime",
        {
            "type": "packages",
            "combined": true
        },
        "shell",
        {
            "type": "display",
            "key": "Resolution",
            "compactType": "original"
        },
        {
            "type": "wm",
            "key": "WM"
        },
        "theme",
        "icons",
        "terminal",
        {
            "type": "cpu",
            "showPeCoreCount": false,
            "format": "{name} ({cores-logical}) @ {freq-base}"
        },
        {
            "type": "gpu",
            "format": "{name}"
        },
        {
            "type": "memory",
            "format": "{used} / {total}"
        },
        "break",
        {
            "type": "colors",
            "key": " "
        }
    ]
}
