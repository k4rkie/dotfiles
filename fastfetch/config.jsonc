{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
      "source": "~/.config/fastfetch/tux.txt",
      "height": 2,
      "color": {
          "1": "38;2;193;193;193"
      },
      "width": 4,
      "padding": {
          "left": 2
      }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    "break",
    "title",
    {
      "type": "os",
      "key": "os    ",
      "keyColor": "33",
    },
    {
      "type": "kernel",
      "key": "kernel",
      "keyColor": "33",
    },
    {
      "type": "packages",
      "format": "{}",
      "key": "pkgs  ",
      "keyColor": "33",
    },
    {
      "type": "uptime",
      "format": "{2}h {3}m",
      "key": "uptime",
      "keyColor": "33",
    },
    {
      "type": "command",
      "key": "age   ",
      "keyColor": "33",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "memory",
      "key": "memory",
      "keyColor": "33",
    },
    "break",
  ]
}
